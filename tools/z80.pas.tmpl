unit hwsim.z80;

{ Zilog Z80 CPU, run on the edges of its clock (port of chips/z80.h:
  floooh's Z80, zlib license, Copyright (c) 2021 Andre Weissflog, altered
  by c64-hw-sim to process single clock edges).

  GENERATED by tools/gen_z80.py from z80.h and tools/z80.pas.tmpl:
  edit those, not this file.

  Pins (bits of an Integer): control pins 0..15 (see the constants),
  D0-D7 16..23, IEIO 24, RETI 25. The address bus A0-A15 is the field 'ab'
  (in the C code it is bits 0..15 of the pin mask; it is only an output).

  Registers live in r8/r16, two views of the same 20 bytes, like the C
  unions: r16[0] = PC, AF, BC, DE, HL, IX, IY, WZ, SP, IR (slots 0..9),
  r8[2*slot] the low byte, r8[2*slot + 1] the high byte. }

interface

uses
  qtx.sysutils;

const
{%CONSTS%}

type
  TZ80 = class
  private
{%DECLS%}
    function Z_set_ab_ctl(pins, ab_, ctl: Integer): Integer;
    function Z_res(pins: Integer): Integer;
    procedure ResetRegs;
  public
    buf: JArrayBuffer;
    r8: JUint8Array;
    r16: JUint16Array;
    ab: Integer;               { address bus A0-A15 }
    step, brq_step, addr: Integer;
    dlatch, opcode, hlx_idx: Integer;
    prefix_active: Boolean;
    FPINS: Integer;            { pin state after the last Tick }
    int_bits, nmi_latch: Integer;
    af2, bc2, de2, hl2: Integer;
    im: Integer;
    iff1, iff2: Boolean;
    constructor Create;
    function Init: Integer;
    function Reset: Integer;
    function Tick(inp: Integer): Integer;
    function OpDone: Boolean;
    { Force execution to continue at new_pc. }
    function Prefetch(new_pc: Integer): Integer;
    function PC: Integer;
    function AF: Integer;
    function BC: Integer;
    function DE: Integer;
    function HL: Integer;
    function SP: Integer;
    function IX: Integer;
    function IY: Integer;
    function IR: Integer;
  end;

implementation

const
  SZP_FLAGS: array[0..255] of Integer = [{%SZP%}];
  INDIRECT_TABLE: array[0..255] of Integer = [{%INDIRECT%}];

function IfI(c: Boolean; a, b: Integer): Integer;
begin
  if c then Result := a else Result := b;
end;

function IfB(c: Boolean; a, b: Boolean): Boolean;
begin
  if c then Result := a else Result := b;
end;

constructor TZ80.Create;
begin
  inherited Create;
  buf := new JArrayBuffer(20);
  r8 := new JUint8Array(buf);
  r16 := new JUint16Array(buf);
end;

function TZ80.PC: Integer; begin Result := r16[0]; end;
function TZ80.AF: Integer; begin Result := r16[1]; end;
function TZ80.BC: Integer; begin Result := r16[2]; end;
function TZ80.DE: Integer; begin Result := r16[3]; end;
function TZ80.HL: Integer; begin Result := r16[4]; end;
function TZ80.IX: Integer; begin Result := r16[5]; end;
function TZ80.IY: Integer; begin Result := r16[6]; end;
function TZ80.SP: Integer; begin Result := r16[8]; end;
function TZ80.IR: Integer; begin Result := r16[9]; end;

{ Initial state as described in 'The Undocumented Z80 Documented' (PC, I,
  R, IFF1/2, IM are 0), the pin state is preserved. }
procedure TZ80.ResetRegs;
var i: Integer;
begin
  for i := 0 to 9 do r16[i] := 0;
  step := 0; brq_step := 0; addr := 0;
  dlatch := 0; opcode := 0; hlx_idx := 0;
  prefix_active := False;
  int_bits := 0; nmi_latch := 0;
  im := 0;
  iff1 := False; iff2 := False;
  r16[1] := $FFFF; r16[2] := $FFFF; r16[3] := $FFFF; r16[4] := $FFFF;
  r16[7] := $FFFF; r16[8] := $FFFF; r16[5] := $FFFF; r16[6] := $FFFF;
  af2 := $FFFF; bc2 := $FFFF; de2 := $FFFF; hl2 := $FFFF;
end;

function TZ80.Init: Integer;
begin
  ResetRegs;
  ab := 0;
  step := 0;
  FPINS := Z80_AOE;
  Result := FPINS;
end;

function TZ80.Reset: Integer;
begin
  ResetRegs;
  if (FPINS and Z80_CLK) <> 0 then step := Z80_PREFETCH_L else step := 0;
  ab := 0;
  FPINS := (FPINS and not Z80_OUTPUT_PIN_MASK) or Z80_AOE;
  Result := FPINS;
end;

function TZ80.OpDone: Boolean;
begin
  Result := ((step = Z80_M1_T1L) or (step = Z80_HALT_M1_T1L) or (step = Z80_NMI_M1_T1L)) and not prefix_active;
end;

function TZ80.Prefetch(new_pc: Integer): Integer;
begin
  r16[0] := new_pc;
  int_bits := int_bits and not Z80_HALT;
  if (FPINS and Z80_CLK) <> 0 then step := Z80_PREFETCH_L else step := 0;
  FPINS := (FPINS and not (Z80_CTRL_OUT_MASK or Z80_HALT or Z80_BUSAK or Z80_RETI)) or Z80_AOE;
  Result := FPINS;
end;

function TZ80.Z_set_ab_ctl(pins, ab_, ctl: Integer): Integer;
begin
  ab := ab_ and $FFFF;
  Result := (pins and not Z80_CTRL_OUT_MASK) or ctl or Z80_AOE;
end;

function TZ80.Z_res(pins: Integer): Integer;
begin
  ResetRegs;
  step := Z80_RES_L;
  ab := 0;
  Result := pins and not Z80_OUTPUT_PIN_MASK;
end;

{%IMPLS%}

function TZ80.Tick(inp: Integer): Integer;
var
  prev, own, pins, lbl: Integer;
{%TICKVARS%}begin
  prev := FPINS;
  { pins driven by the CPU come from the CPU state, all others from the caller }
  own := Z80_OUTPUT_PIN_MASK;
  if (prev and Z80_DOE) <> 0 then own := own or $FF0000;
  pins := (inp and not own) or (prev and own);
  { NMI is edge triggered: latch an inactive => active transition at any time }
  nmi_latch := nmi_latch or (pins and not prev and Z80_NMI);
  if ((pins xor prev) and Z80_CLK) = 0 then begin
    FPINS := pins;
    exit(pins);
  end;
  lbl := 4;
{%DECODER%}
  if lbl <= 1 then pins := Z_fetch(pins);
  if lbl <= 2 then
    int_bits := (int_bits and Z80_HALT) or nmi_latch or (pins and (Z80_INT or Z80_BUSRQ));
  if lbl <= 3 then
    if (pins and Z80_RES) <> 0 then pins := Z_res(pins);
  { edge_done }
  if (prev and not pins and Z80_DOE) <> 0 then
    pins := (pins and not $FF0000) or (inp and $FF0000);
  FPINS := pins;
  Result := pins;
end;

end.
