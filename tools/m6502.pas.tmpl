  IRQ 26, NMI 27, RDY 28, AEC 29, RES 30. }

interface

const
{%CONSTS%}

type
  TM6510InFn = function(user: TObject): Integer;
  TM6510OutFn = procedure(data: Integer; user: TObject);

  TM6502 = class
  private
    procedure Adc(val: Integer);
    procedure Sbc(val: Integer);
    procedure Cmp(r, v: Integer);
    function Asl(v: Integer): Integer;
    function Lsr(v: Integer): Integer;
    function Rol(v: Integer): Integer;
    function Ror(v: Integer): Integer;
    procedure Bit(v: Integer);
    procedure Arr;
    procedure Sbx(v: Integer);
  public
    IR, PC, AD: Integer;
    A, X, Y, S, P: Integer;
    FPINS: Integer;   { last stored pin state }
    irq_pip, nmi_pip: Integer;
    brk_flags: Integer;
    bcd_enabled: Integer;
    user_data: TObject;
    in_cb: TM6510InFn;
    out_cb: TM6510OutFn;
    io_ddr, io_inp, io_out, io_pins, io_pullup, io_floating, io_drive: Integer;
    { Reset to power-on state, returns the initial pin mask. }
    function Init(bcd_disabled: Boolean; ain: TM6510InFn; aout: TM6510OutFn; user: TObject;
      pullup, floating: Integer): Integer;
    function Tick(pins: Integer): Integer;
    { 6510 port access (only when M6510_CHECK_IO). }
    function IORQ(pins: Integer): Integer;
  end;

function M6502_GET_ADDR(p: Integer): Integer;
function M6502_GET_DATA(p: Integer): Integer;
function M6502_SET_DATA(p, d: Integer): Integer;
function M6502_SET_ADDR(p, a: Integer): Integer;
function M6510_CHECK_IO(p: Integer): Boolean;

implementation

function IfI(c: Boolean; a, b: Integer): Integer;
begin
  if c then Result := a else Result := b;
end;

function M6502_GET_ADDR(p: Integer): Integer;
begin
  Result := p and $FFFF;
end;

function M6502_GET_DATA(p: Integer): Integer;
begin
  Result := (p shr 16) and $FF;
end;

function M6502_SET_DATA(p, d: Integer): Integer;
begin
  Result := (p and not $FF0000) or ((d and $FF) shl 16);
end;

function M6502_SET_ADDR(p, a: Integer): Integer;
begin
  Result := (p and not $FFFF) or (a and $FFFF);
end;

function M6510_CHECK_IO(p: Integer): Boolean;
begin
  Result := (p and $FFFE) = 0;
end;

function NZ(p, v: Integer): Integer;
begin
  if (v and $FF) <> 0 then Result := (p and not (M6502_NF or M6502_ZF)) or (v and M6502_NF)
  else Result := (p and not (M6502_NF or M6502_ZF)) or M6502_ZF;
end;

procedure TM6502.Adc(val: Integer);
var c, al, ah, sum: Integer;
begin
  if (bcd_enabled <> 0) and ((P and M6502_DF) <> 0) then begin
    { decimal mode (credit goes to MAME) }
    if (P and M6502_CF) <> 0 then c := 1 else c := 0;
    P := P and not (M6502_NF or M6502_VF or M6502_ZF or M6502_CF);
    al := ((A and $0F) + (val and $0F) + c) and $FF;
    if al > 9 then al := (al + 6) and $FF;
    ah := ((A shr 4) + (val shr 4) + Ord(al > $0F)) and $FF;
    if ((A + val + c) and $FF) = 0 then P := P or M6502_ZF
    else if (ah and $08) <> 0 then P := P or M6502_NF;
    if ((not (A xor val)) and (A xor ((ah shl 4) and $FF)) and $80) <> 0 then P := P or M6502_VF;
    if ah > 9 then ah := (ah + 6) and $FF;
    if ah > 15 then P := P or M6502_CF;
    A := ((ah shl 4) or (al and $0F)) and $FF;
  end else begin
    { default mode }
    sum := (A + val + Ord((P and M6502_CF) <> 0)) and $FFFF;
    P := P and not (M6502_VF or M6502_CF);
    P := NZ(P, sum);
    if ((not (A xor val)) and (A xor sum) and $80) <> 0 then P := P or M6502_VF;
    if (sum and $FF00) <> 0 then P := P or M6502_CF;
    A := sum and $FF;
  end;
end;

procedure TM6502.Sbc(val: Integer);
var c, diff, al, ah: Integer;
begin
  if (bcd_enabled <> 0) and ((P and M6502_DF) <> 0) then begin
    { decimal mode (credit goes to MAME) }
    if (P and M6502_CF) <> 0 then c := 0 else c := 1;
    P := P and not (M6502_NF or M6502_VF or M6502_ZF or M6502_CF);
    diff := (A - val - c) and $FFFF;
    al := ((A and $0F) - (val and $0F) - c) and $FF;
    if (al and $80) <> 0 then al := (al - 6) and $FF;
    ah := ((A shr 4) - (val shr 4) - Ord((al and $80) <> 0)) and $FF;
    if (diff and $FF) = 0 then P := P or M6502_ZF
    else if (diff and $80) <> 0 then P := P or M6502_NF;
    if ((A xor val) and (A xor diff) and $80) <> 0 then P := P or M6502_VF;
    if (diff and $FF00) = 0 then P := P or M6502_CF;
    if (ah and $80) <> 0 then ah := (ah - 6) and $FF;
    A := ((ah shl 4) or (al and $0F)) and $FF;
  end else begin
    { default mode }
    if (P and M6502_CF) <> 0 then c := 0 else c := 1;
    diff := (A - val - c) and $FFFF;
    P := P and not (M6502_VF or M6502_CF);
    P := NZ(P, diff and $FF);
    if ((A xor val) and (A xor diff) and $80) <> 0 then P := P or M6502_VF;
    if (diff and $FF00) = 0 then P := P or M6502_CF;
    A := diff and $FF;
  end;
end;

procedure TM6502.Cmp(r, v: Integer);
var t: Integer;
begin
  t := (r - v) and $FFFF;
  P := NZ(P, t and $FF) and not M6502_CF;
  if (t and $FF00) = 0 then P := P or M6502_CF;
end;

function TM6502.Asl(v: Integer): Integer;
begin
  P := NZ(P, v shl 1) and not M6502_CF;
  if (v and $80) <> 0 then P := P or M6502_CF;
  Result := (v shl 1) and $FF;
end;

function TM6502.Lsr(v: Integer): Integer;
begin
  P := NZ(P, v shr 1) and not M6502_CF;
  if (v and 1) <> 0 then P := P or M6502_CF;
  Result := v shr 1;
end;

function TM6502.Rol(v: Integer): Integer;
var carry: Boolean;
begin
  carry := (P and M6502_CF) <> 0;
  P := P and not (M6502_NF or M6502_ZF or M6502_CF);
  if (v and $80) <> 0 then P := P or M6502_CF;
  v := (v shl 1) and $FF;
  if carry then v := v or 1;
  P := NZ(P, v);
  Result := v;
end;

function TM6502.Ror(v: Integer): Integer;
var carry: Boolean;
begin
  carry := (P and M6502_CF) <> 0;
  P := P and not (M6502_NF or M6502_ZF or M6502_CF);
  if (v and 1) <> 0 then P := P or M6502_CF;
  v := v shr 1;
  if carry then v := v or $80;
  P := NZ(P, v);
  Result := v;
end;

procedure TM6502.Bit(v: Integer);
var t: Integer;
begin
  t := A and v;
  P := P and not (M6502_NF or M6502_VF or M6502_ZF);
  if t = 0 then P := P or M6502_ZF;
  P := P or (v and (M6502_NF or M6502_VF));
end;

procedure TM6502.Arr;
var
  c: Boolean;
  a8: Integer;
begin
  if (bcd_enabled <> 0) and ((P and M6502_DF) <> 0) then begin
    c := (P and M6502_CF) <> 0;
    P := P and not (M6502_NF or M6502_VF or M6502_ZF or M6502_CF);
    a8 := A shr 1;
    if c then a8 := a8 or $80;
    P := NZ(P, a8);
    if ((a8 xor A) and $40) <> 0 then P := P or M6502_VF;
    if (A and $F) >= 5 then a8 := (((a8 + 6) and $F) or (a8 and $F0)) and $FF;
    if (A and $F0) >= $50 then begin
      a8 := (a8 + $60) and $FF;
      P := P or M6502_CF;
    end;
    A := a8;
  end else begin
    c := (P and M6502_CF) <> 0;
    P := P and not (M6502_NF or M6502_VF or M6502_ZF or M6502_CF);
    A := A shr 1;
    if c then A := A or $80;
    P := NZ(P, A);
    if (A and $40) <> 0 then P := P or M6502_VF or M6502_CF;
    if (A and $20) <> 0 then P := P xor M6502_VF;
  end;
end;

procedure TM6502.Sbx(v: Integer);
var t: Integer;
begin
  t := ((A and X) - v) and $FFFF;
  P := NZ(P, t) and not M6502_CF;
  if (t and $FF00) = 0 then P := P or M6502_CF;
  X := t and $FF;
end;

function TM6502.Init(bcd_disabled: Boolean; ain: TM6510InFn; aout: TM6510OutFn; user: TObject;
  pullup, floating: Integer): Integer;
begin
  IR := 0; PC := 0; AD := 0;
  A := 0; X := 0; Y := 0; S := 0;
  P := M6502_ZF;
  irq_pip := 0; nmi_pip := 0; brk_flags := 0;
  if bcd_disabled then bcd_enabled := 0 else bcd_enabled := 1;
  FPINS := M6502_RW or M6502_SYNC or M6502_RES;
  in_cb := ain;
  out_cb := aout;
  user_data := user;
  io_ddr := 0; io_inp := 0; io_out := 0; io_pins := 0; io_drive := 0;
  io_pullup := pullup;
  io_floating := floating;
  Result := FPINS;
end;

function TM6502.IORQ(pins: Integer): Integer;
var val: Integer;
begin
  if (pins and M6502_A0) = 0 then begin
    { address 0: data direction register }
    if (pins and M6502_RW) <> 0 then
      pins := M6502_SET_DATA(pins, io_ddr)
    else begin
      io_ddr := M6502_GET_DATA(pins);
      io_drive := ((io_out and io_ddr) or (io_drive and not io_ddr)) and $FF;
      if Assigned(out_cb) then out_cb(((io_out and io_ddr) or (io_pullup and not io_ddr)) and $FF, user_data);
      io_pins := ((io_out and io_ddr) or (io_inp and not io_ddr)) and $FF;
    end;
  end else begin
    { address 1: I/O }
    if (pins and M6502_RW) <> 0 then begin
      if Assigned(in_cb) then io_inp := in_cb(user_data) and $FF;
      val := (((io_inp or (io_floating and io_drive)) and not io_ddr) or (io_out and io_ddr)) and $FF;
      pins := M6502_SET_DATA(pins, val);
    end else begin
      io_out := M6502_GET_DATA(pins);
      io_drive := ((io_out and io_ddr) or (io_drive and not io_ddr)) and $FF;
      if Assigned(out_cb) then out_cb(((io_out and io_ddr) or (io_pullup and not io_ddr)) and $FF, user_data);
    end;
    io_pins := ((io_out and io_ddr) or (io_inp and not io_ddr)) and $FF;
  end;
  Result := pins;
end;

function TM6502.Tick(pins: Integer): Integer;
var irv: Integer;
begin
{%DECODER%}
  FPINS := pins;
  irq_pip := (irq_pip shl 1) and $FFFF;
  nmi_pip := (nmi_pip shl 1) and $FFFF;
  Result := pins;
end;

end.
