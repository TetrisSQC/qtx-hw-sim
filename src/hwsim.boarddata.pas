unit hwsim.boarddata;

{ The boards as plain tables (generated by tools/gen_data.py into
  hwsim.bd_c64 / hwsim.bd_zx48). Coordinates are in millimeters, x to the
  right, y down, as in KiCad. }

interface

type
  TBdPad = record
    name: String;     { pad name: "1".."40" for ICs, letters on some connectors }
    x, y: Float;      { absolute center position (mm) }
    w, h: Float;      { pad size (mm) }
    net: Integer;     { index into the nets, or -1 if unconnected }
  end;

  TBdComp = record
    ref: String;        { "U17" }
    value: String;      { "PLA_U17", "3K3", ... }
    footprint: String;  { KiCad footprint name }
    first_pad, npads: Integer;
  end;

  TBoardData = class
  public
    outline: array[0..3] of Float;  { x0, y0, x1, y1 of the board edge }
    nets: array of String;
    nnets: Integer;
    pads: array of TBdPad;
    npads: Integer;
    comps: array of TBdComp;
    ncomps: Integer;
  end;

implementation

end.
